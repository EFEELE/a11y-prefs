{
  "name": "a11y-prefs",
  "version": "0.1.0",
  "description": "Accessibility preferences panel as a web component. No dependencies, translatable, configurable position and shape.",
  "type": "module",
  "license": "MIT",
  "author": "EFEELE <ferbock10@gmail.com>",
  "sideEffects": ["./dist/auto.js", "./dist/a11y-prefs.js"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/a11y-prefs.js",
  "jsdelivr": "./dist/a11y-prefs.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./script": "./dist/a11y-prefs.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "web-component",
    "custom-element",
    "wcag",
    "preferences"
  ],
  "scripts": {
    "build": "node build.mjs && tsc",
    "dev": "node build.mjs --watch",
    "demo": "node scripts/serve.mjs",
    "wp:sync": "npm run build && node scripts/sync-wordpress.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": ["dist"],
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
